{
  "name": "prcine",
  "version": "0.1.0",
  "description": "Turn any GitHub PR or git range into a 15-second trailer video (MP4 + looping WebP), 16:9 or 9:16. One command, no API key.",
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "npm run build && node --test test/core.test.mjs"
  },
  "keywords": [
    "changelog",
    "cli",
    "code",
    "demo",
    "diff",
    "git",
    "github",
    "pull-request",
    "readme",
    "social",
    "trailer",
    "twitter",
    "video",
    "x"
  ],
  "author": "kevin9327",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  },
  "bin": {
    "prcine": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets/fonts",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevin9327/prcine.git"
  },
  "homepage": "https://github.com/kevin9327/prcine#readme"
}
